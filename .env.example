# PostgreSQL connection strings (Render provides these after the database is created)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oilerp_db?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/oilerp_db?schema=public"

# Environment
NODE_ENV="development"

# Use a long, random value in every real environment.
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000

# API Server Configuration
FRONTEND_URL="http://localhost:3000"

# Used by the Next.js server-side proxy. Local default: http://localhost:4000
API_URL="http://localhost:4000"

# Optional: only needed when Redis-backed queues or cache features are enabled.
REDIS_URL="redis://localhost:6379"

# For Render deployment, set:
# FRONTEND_URL=https://oilerp-web.onrender.com
# API_URL=https://oilerp-api.onrender.com
