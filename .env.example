# PostgreSQL connection strings (Render provides these after the database is created)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oilerp_db?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/oilerp_db?schema=public"

# Use a long, random value in every real environment.
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000

# Used by the Next.js server-side proxy. Local default: http://localhost:4000
API_URL="http://localhost:4000"
