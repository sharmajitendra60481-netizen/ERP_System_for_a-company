generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// TENANT & CORE
// ==========================================

model Company {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users             User[]
  departments       Department[]
  suppliers         Supplier[]
  rawMaterials      RawMaterial[]
  purchaseOrders    PurchaseOrder[]
  storageTanks      StorageTank[]
  productionBatches ProductionBatch[]
  finishedProducts  FinishedProduct[]
  customers         Customer[]
  salesOrders       SalesOrder[]
  invoices          Invoice[]
  qualityInspections QualityInspection[]
  auditLogs          AuditLog[]
  warehouses         Warehouse[]
  inventoryLots      InventoryLot[]
  billsOfMaterials   BillOfMaterials[]
  chartOfAccounts    ChartOfAccount[]
  journalEntries     JournalEntry[]
}

model Department {
  id          String   @id @default(uuid())
  name        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

// ==========================================
// AUTHENTICATION & USERS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  FINANCE_MANAGER
  PRODUCTION_MANAGER
  WAREHOUSE_OPERATOR
  HR_MANAGER
  SALES_REP
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole    @default(WAREHOUSE_OPERATOR)
  isActive       Boolean     @default(true)
  
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  auditLogs      AuditLog[]
}

// Reusable authorization and accountability foundation for every ERP module.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module       String
  action       String
  resourceType String
  resourceId   String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([resourceType, resourceId])
}

model Warehouse {
  id          String              @id @default(uuid())
  code        String
  name        String
  address     String?
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locations   WarehouseLocation[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([companyId, code])
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  code        String
  zone        String?
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([warehouseId, code])
}

model InventoryLot {
  id              String   @id @default(uuid())
  lotNumber       String
  itemType        String
  itemId          String
  quantity        Float
  status          String   @default("AVAILABLE")
  sourceReference String?
  expiryDate      DateTime?
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, lotNumber])
  @@index([companyId, itemType, itemId])
}

model BillOfMaterials {
  id                String    @id @default(uuid())
  code              String
  name              String
  finishedProductId String
  outputQuantity    Float     @default(1)
  version           Int       @default(1)
  isActive          Boolean   @default(true)
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items             BOMItem[]
  productionBatches ProductionBatch[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, code, version])
}

model BOMItem {
  id                String          @id @default(uuid())
  billOfMaterialsId String
  billOfMaterials   BillOfMaterials @relation(fields: [billOfMaterialsId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  quantity          Float
  unit              String
  createdAt         DateTime        @default(now())
}

model ChartOfAccount {
  id          String   @id @default(uuid())
  code        String
  name        String
  type        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  lines       JournalLine[]
  @@unique([companyId, code])
}

model JournalEntry {
  id          String        @id @default(uuid())
  entryNumber String
  entryDate   DateTime      @default(now())
  reference   String?
  description String?
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines       JournalLine[]
  createdAt   DateTime      @default(now())
  @@unique([companyId, entryNumber])
}

model JournalLine {
  id             String          @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Float           @default(0)
  credit         Float           @default(0)
  memo           String?
}

// ==========================================
// PROCUREMENT & RAW MATERIALS
// ==========================================

model Supplier {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  gstin         String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  purchaseOrders PurchaseOrder[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum MaterialType {
  CRUDE_OIL
  CHEMICAL_ADDITIVE
  PACKAGING
}

model RawMaterial {
  id          String       @id @default(uuid())
  sku         String       @unique
  name        String
  type        MaterialType @default(CRUDE_OIL)
  unit        String       @default("Liters") // Liters, KG, Units
  minStock    Float        @default(1000)
  currentStock Float       @default(0)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  poItems     POItem[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum POStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                  String     @id @default(uuid())
  poNumber            String     @unique
  supplierId          String
  supplier            Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status              POStatus   @default(DRAFT)
  totalAmount         Float      @default(0)
  expectedDeliveryDate DateTime?
  companyId           String
  company             Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items               POItem[]

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model POItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterialId   String
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  quantity        Float
  unitPrice       Float
  totalPrice      Float

  createdAt       DateTime      @default(now())
}

// ==========================================
// PRODUCTION & TANKS
// ==========================================

enum TankStatus {
  EMPTY
  FILLING
  STORAGE
  REFINING
  BLENDING
  MAINTENANCE
}

model StorageTank {
  id            String            @id @default(uuid())
  tankNumber    String            @unique
  capacityLiters Float
  currentLevelLiters Float         @default(0)
  oilType       String            @default("Crude Palm Oil")
  status        TankStatus        @default(STORAGE)
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  batches       ProductionBatch[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  QC_CHECK
  COMPLETED
  CANCELLED
}

model ProductionBatch {
  id            String      @id @default(uuid())
  batchNumber   String      @unique
  productName   String
  plannedQty    Float
  actualQty     Float       @default(0)
  status        BatchStatus @default(PLANNED)
  tankId        String?
  tank          StorageTank? @relation(fields: [tankId], references: [id], onDelete: SetNull)
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bomId         String?
  bom           BillOfMaterials? @relation(fields: [bomId], references: [id], onDelete: SetNull)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ==========================================
// INVENTORY & FINISHED GOODS
// ==========================================

model FinishedProduct {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  packageSize String   @default("15L Tin") // 1L Pouch, 5L Can, 15L Tin, 200L Drum
  unitPrice   Float
  currentStock Int     @default(0)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  soItems     SOItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MovementType {
  PO_RECEIPT
  PRODUCTION_OUTPUT
  DISPATCH
  ADJUSTMENT
}

model StockMovement {
  id          String       @id @default(uuid())
  type        MovementType
  reference   String
  itemType    String       // RAW_MATERIAL or FINISHED_GOOD
  itemId      String
  quantity    Float
  notes       String?

  createdAt   DateTime     @default(now())
}

// ==========================================
// SALES, INVOICING & FINANCE
// ==========================================

model Customer {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  gstin         String?
  email         String?
  phone         String?
  address       String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  salesOrders   SalesOrder[]
  invoices      Invoice[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum SOStatus {
  DRAFT
  CONFIRMED
  DISPATCHED
  COMPLETED
  CANCELLED
}

model SalesOrder {
  id          String     @id @default(uuid())
  soNumber    String     @unique
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status      SOStatus   @default(DRAFT)
  totalAmount Float      @default(0)
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items       SOItem[]
  invoices    Invoice[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SOItem {
  id                String          @id @default(uuid())
  salesOrderId      String
  salesOrder        SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  finishedProductId String
  finishedProduct   FinishedProduct @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
  quantity          Int
  unitPrice         Float
  totalPrice        Float

  createdAt         DateTime        @default(now())
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  salesOrderId  String?
  salesOrder    SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subtotal      Float
  taxAmount     Float
  grandTotal    Float
  status        InvoiceStatus @default(UNPAID)
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  payments      Payment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String   @default("BANK_TRANSFER") // BANK_TRANSFER, CHEQUE, CASH
  reference     String?

  createdAt     DateTime @default(now())
}

// Quality records are kept independently from the UI so a release decision is auditable.
model QualityInspection {
  id             String   @id @default(uuid())
  inspectionNo   String   @unique
  batchReference String
  productName    String
  ffaPercentage  Float
  peroxideValue  Float
  moisturePct    Float
  status         String
  notes          String?
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
