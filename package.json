{
  "name": "oil-erp",
  "version": "1.0.0",
  "private": true,
  "description": "OilERP — Enterprise Resource Planning & Manufacturing Management System",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:web": "pnpm --filter web dev",
    "desktop": "pnpm --filter @oil-erp/desktop start",
    "desktop:dev": "pnpm --filter @oil-erp/desktop dev",
    "build:web": "pnpm --filter web build",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "bullmq": "^6.3.1",
    "handlebars": "^4.7.9",
    "pdfkit": "^0.20.1",
    "redis": "^6.2.1",
    "uuid": "^14.0.2"
  }
}
